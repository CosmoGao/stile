# Stile 配置示例
# 登录凭证有效期、失败锁定次数、锁定时长都还没有产品定值。
# 下面出现的数字只是示例，不是产品规则。改配置即可，不要写进代码。

listen 127.0.0.1:8080
database /var/lib/Stile/Stile.db
master_key /etc/Stile/master.key

# 本地 HTTP 保持 false；通过 HTTPS（含反向代理）访问时设置 true。
# 这只设置 Cookie Secure 属性，不会启用 HTTPS。
cookie_secure false

# 示例，数值未定
session_ttl 8h

# 示例，数值未定
lockout_failures 4

# 示例，数值未定
lockout_duration 10m

# 外部 guacd 1.4.0 的地址。不写这一项时，网页 RDP 连不上，网页 SSH 不受影响。
# guacd 127.0.0.1:4822
